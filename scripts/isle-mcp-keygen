#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Manages per-client MCP tokens in ~/.config/isle/mcp-clients.json (mode 0600).
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/isle/mcp-clients.json"
COMMAND="${1:-}"

usage() {
    cat <<'EOF'
isle-mcp-keygen add <client-name> [scope ...]   Generate a token for a client (default scope: *:read)
isle-mcp-keygen list                            List client names and scopes (never the tokens)
isle-mcp-keygen revoke <client-name>             Remove a client's token
EOF
}

json() {
    CONFIG="$CONFIG" python3 - "$@" <<'PY'
import json, os, sys

config_path = os.environ["CONFIG"]
os.makedirs(os.path.dirname(config_path), exist_ok=True)
try:
    with open(config_path, encoding="utf-8") as config_file:
        clients = json.load(config_file)
except FileNotFoundError:
    clients = {}

command = sys.argv[1]
if command == "add":
    name, scopes = sys.argv[2], sys.argv[3:] or ["*:read"]
    if not name or name in clients:
        raise SystemExit("A client name is required, and it must be new")
    import secrets
    token = secrets.token_urlsafe(32)
    clients[name] = {"token": token, "scopes": scopes}
    with open(config_path, "w", encoding="utf-8") as config_file:
        json.dump(clients, config_file, indent=2)
        config_file.write("\n")
    os.chmod(config_path, 0o600)
    print(token)
elif command == "list":
    for name, entry in clients.items():
        print(f"{name}: {', '.join(entry.get('scopes', []))}")
elif command == "revoke":
    name = sys.argv[2]
    if name not in clients:
        raise SystemExit(f"No client named {name!r}")
    del clients[name]
    with open(config_path, "w", encoding="utf-8") as config_file:
        json.dump(clients, config_file, indent=2)
        config_file.write("\n")
    os.chmod(config_path, 0o600)
    print("revoked")
else:
    raise SystemExit("Unknown command")
PY
}

case "$COMMAND" in
    add) [ "${2:-}" ] || { usage >&2; exit 1; }
        token=$(json add "$2" "${@:3}")
        echo "Token for $2 (shown once):"
        echo "$token"
        echo "Restart the service to apply: systemctl --user restart isle-mcp.service"
        ;;
    list) json list ;;
    revoke) [ "${2:-}" ] || { usage >&2; exit 1; }
        json revoke "$2"
        echo "Restart the service to apply: systemctl --user restart isle-mcp.service"
        ;;
    *) usage >&2; exit 1 ;;
esac
