#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/notchfolk"
SERVER="$DATA/mcp/server.py"
[ -f "$SERVER" ] || SERVER="/usr/lib/notchfolk/mcp/server.py"
PYTHON="$DATA/mcp-venv/bin/python"
if [ ! -x "$PYTHON" ] || [ ! -f "$SERVER" ]; then
    echo "Set up Notchfolk MCP first: notchfolk-setup-mcp" >&2
    exit 1
fi
exec "$PYTHON" "$SERVER"
