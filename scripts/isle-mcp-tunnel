#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Cloudflare Tunnel management for Isle's MCP server.
#
#   isle-mcp-tunnel run                 Temporary public URL (quick tunnel, no account)
#   isle-mcp-tunnel setup <hostname>    Named tunnel on your domain: login, create,
#                                       automatic DNS (CNAME), config, user service
#   isle-mcp-tunnel status              Is the named tunnel running?
#   isle-mcp-tunnel stop                Stop and disable the named tunnel
#
# The MCP server stays bound to loopback; cloudflared connects out to
# Cloudflare, so no port is opened to the network. Bearer tokens still apply.
set -euo pipefail

HOST="${ISLE_MCP_HOST:-127.0.0.1}"
PORT="${ISLE_MCP_PORT:-8765}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/isle/cloudflared"
TUNNEL_NAME="isle-mcp"
SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/isle-mcp-tunnel.service"
CERT="${HOME}/.cloudflared/cert.pem"

need_cloudflared() {
    command -v cloudflared >/dev/null || {
        echo "cloudflared is not installed. Install it first:" >&2
        echo "  https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/" >&2
        exit 1
    }
}

need_token() {
    TOKEN_COUNT=$(python3 - <<'PY'
import json, os
config = os.path.expanduser("~/.config/isle/mcp-clients.json")
env_path = os.path.expanduser("~/.config/isle/mcp.env")
count = 0
try:
    with open(config, encoding="utf-8") as config_file:
        count += sum(1 for entry in json.load(config_file).values() if entry.get("token"))
except FileNotFoundError:
    pass
try:
    with open(env_path, encoding="utf-8") as env_file:
        count += sum(1 for line in env_file if line.startswith("ISLE_MCP_TOKEN="))
except FileNotFoundError:
    pass
print(count)
PY
)
    [ "$TOKEN_COUNT" -gt 0 ] || {
        echo "The tunnel is public: configure a token first." >&2
        echo "Run: isle-mcp-keygen add <client-name> [scope ...]" >&2
        echo "Or use Isle Settings → MCP → Generate key." >&2
        exit 1
    }
}

case "${1:-}" in
    run)
        need_cloudflared
        need_token
        echo "Starting a Cloudflare quick tunnel to http://$HOST:$PORT (temporary URL, Ctrl+C to stop)."
        echo "Connect an agent to https://<printed-url>/mcp with its bearer token."
        exec cloudflared tunnel --url "http://$HOST:$PORT"
        ;;

    setup)
        [ "${2:-}" ] || { echo "Usage: isle-mcp-tunnel setup <hostname>   e.g. isle.example.com" >&2; exit 1; }
        HOSTNAME="$2"
        need_cloudflared
        need_token

        echo "1/5 Cloudflare login (opens your browser once; cert: $CERT)"
        [ -f "$CERT" ] || cloudflared tunnel login

        echo "2/5 Creating the tunnel (named $TUNNEL_NAME)"
        TUNNEL_ID="$(cloudflared tunnel list -o json | python3 -c "
import json, sys
for tunnel in json.load(sys.stdin):
    if tunnel['name'] == '$TUNNEL_NAME':
        print(tunnel['id'])
        break
")"
        if [ -z "$TUNNEL_ID" ]; then
            TUNNEL_ID="$(cloudflared tunnel create "$TUNNEL_NAME" | grep -oP '(?<=Created tunnel )[0-9a-f-]{36}' || true)"
            [ -n "$TUNNEL_ID" ] || TUNNEL_ID="$(cloudflared tunnel list -o json | python3 -c "
import json, sys
for tunnel in json.load(sys.stdin):
    if tunnel['name'] == '$TUNNEL_NAME':
        print(tunnel['id'])
        break
")"
        fi
        [ -n "$TUNNEL_ID" ] || { echo "Could not create or find the tunnel." >&2; exit 1; }
        echo "    Tunnel id: $TUNNEL_ID"

        echo "3/5 Pointing $HOSTNAME at the tunnel (automatic DNS CNAME)"
        cloudflared tunnel route dns "$TUNNEL_ID" "$HOSTNAME" 2>/dev/null \
            || echo "    DNS record already exists for $HOSTNAME; leaving it as it is."

        echo "4/5 Writing the tunnel config"
        mkdir -p "$CONFIG_DIR"
        CREDENTIALS="${HOME}/.cloudflared/${TUNNEL_ID}.json"
        [ -f "$CREDENTIALS" ] || { echo "Credentials file $CREDENTIALS is missing; recreate the tunnel with:" >&2
            echo "  cloudflared tunnel delete $TUNNEL_NAME && isle-mcp-tunnel setup $HOSTNAME" >&2; exit 1; }
        cat > "$CONFIG_DIR/config.yml" <<YML
tunnel: $TUNNEL_ID
credentials-file: $CREDENTIALS
ingress:
  - hostname: $HOSTNAME
    service: http://$HOST:$PORT
  - service: http_status:404
YML
        chmod 600 "$CONFIG_DIR/config.yml" 2>/dev/null || true
        [ -f "$CREDENTIALS" ] || { echo "Credentials file $CREDENTIALS is missing." >&2; exit 1; }

        echo "5/5 Installing and starting the user service"
        mkdir -p "$(dirname "$SERVICE_FILE")"
        cat > "$SERVICE_FILE" <<UNIT
[Unit]
Description=Cloudflare Tunnel for Isle's MCP server
After=isle-mcp.service

[Service]
ExecStart=/usr/bin/env cloudflared tunnel --config "$CONFIG_DIR/config.yml" run "$TUNNEL_NAME"
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
        systemctl --user daemon-reload
        systemctl --user enable --now isle-mcp-tunnel.service

        echo
        echo "Done. Isle's MCP server is reachable at:"
        echo "  https://$HOSTNAME/mcp"
        echo "Give an agent that URL and a key from isle-mcp-keygen (or Settings → MCP)."
        ;;

    status)
        systemctl --user is-active isle-mcp-tunnel.service && echo "Endpoint: https://$(grep -oP '(?<=hostname: ).+' "$CONFIG_DIR/config.yml" | head -1)/mcp" || true
        ;;

    stop)
        systemctl --user disable --now isle-mcp-tunnel.service
        echo "Stopped. Delete the DNS record in Cloudflare's dashboard to remove $HOSTNAME."
        ;;

    *)
        echo "Usage: isle-mcp-tunnel {run|setup <hostname>|status|stop}" >&2
        exit 1
        ;;
esac
